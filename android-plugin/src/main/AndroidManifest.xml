<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Godot finds v2 plugins by this entry: name, then class. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.GoogleSignIn"
            android:value="com.pranerdhaka.googlesignin.GoogleSignInPlugin" />
        <!-- The day's picture, handed to the share sheet (files/share/). -->
        <provider
            android:name="com.pranerdhaka.googlesignin.ShareFileProvider"
            android:authorities="${applicationId}.pranerdhaka.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pranerdhaka_share_paths" />
        </provider>
    </application>
</manifest>
