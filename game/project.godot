; Engine configuration file.
; Godot 4.5. Open this folder in the Godot editor, or see .github/workflows/game.yml.

config_version=5

[application]

config/name="Dhakar Ekdin"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[debug]

; Keep a log on phones too, so a crash can be read on the next start.
file_logging/enable_file_logging=true

[gui]

theme/custom_font="res://fonts/HindSiliguri-Regular.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

; Text server (ICU) data, ~4 MB. Left out once to save space; put back while
; a crash on phones is looked into.
locale/include_text_server_data=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
